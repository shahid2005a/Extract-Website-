# 📄 app/config.py
# ============================================================
import os
from dotenv import load_dotenv

load_dotenv()

class Config:
    SECRET_KEY = os.getenv('SECRET_KEY', 'dev-key-123')
    DEBUG = os.getenv('FLASK_DEBUG', 'True').lower() == 'true'
    PORT = int(os.getenv('APP_PORT', 5000))

# ============================================================
# 📄 app/routes.py
# ============================================================
from flask import Blueprint, render_template

main_bp = Blueprint('main', __name__)

@main_bp.route('/')
def home():
    context = {
        'title': 'Ghar ka Page',
        'heading': 'Namaste Dosto!',
        'subtext': 'Python + Flask se professional serve ho raha hai 💪'
    }
    return render_template('index.html', **context)

@main_bp.route('/about')
def about():
    return "<h2>About Page</h2><p>Ye ek modern Python server hai.</p>"

